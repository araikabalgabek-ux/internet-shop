@startuml
' Желілердің орналасу бағыты (Жоғарыдан төменге қарай)
top to bottom direction

' --- Кластардың жалпы стилі ---
skinparam class {
    BorderColor #7F7F7F
    ArrowColor #595959
}

' --- Жоғарғы деңгейдегі кластар ---
class "User" as User #FCE4D6 {
    -int id
    -string name
    -string email
    -string password
    -string role
    __
    +login()
    +logout()
    +updateProfile()
}

class "Product" as Product #E2F0D9 {
    -int id
    -string name
    -string description
    -double price
    -int stock
    -string category
    __
    +getInfo()
    +updateStock()
    +setPrice()
}

class "Category" as Category #FFF2CC {
    -int id
    -string name
    -string description
    __
    +getProducts()
    +addCategory()
}

class "Cart" as Cart #E8F1F5 {
    -int id
    -int userId
    -DateTime createdAt
    __
    +addItem()
    +removeItem()
    +clearCart()
}

class "Order" as Order #DEEAF6 {
    -int id
    -DateTime date
    -string status
    -double totalAmount
    __
    +addItem()
    +removeItem()
    +calculateTotal()
    +changeStatus()
}

' --- Төменгі деңгейдегі жаңа кластар ---
class "OrderItem" as OrderItem #E2F0D9 {
    -int id
    -int quantity
    -double price
    __
    +getSubtotal()
}

class "Delivery" as Delivery #F8CECC {
    -int id
    -int orderId
    -string address
    -string status
    -int courierId
    __
    +assignCourier()
    +changeStatus()
}

class "Payment" as Payment #FFF2CC {
    -int id
    -int orderId
    -double amount
    -string method
    -string status
    __
    +pay()
    +getStatus()
}

class "Courier" as Courier #DEEAF6 {
    -int id
    -string name
    -string phone
    __
    +updateStatus()
    +getOrders()
}

' --- Кластар арасындағы байланыстар (Суреттегі жазуларымен және белгілерімен) ---
User "1" -- "0..*" Order : жасайды >
User "1" -- "1" Cart : иеленеді >
Category "1" -- "0..*" Product : жатады >
Cart "0..*" -- "0..*" Product : қосылады >

' Агрегация мен композиция байланыстары (Ромбтар суреттегідей бағытталған)
Order *-- "1..*" OrderItem : құрамында >
Order "1" -- "1" Delivery : жеткізіледі >
Order "1" -- "1" Payment : төленеді >

Delivery "0..*" -- "1" Courier : орындайды >

@enduml